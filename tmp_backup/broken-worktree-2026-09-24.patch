+++ b/fpga/osd_display/tests/tb_fat32_wav_loader.sv
@@ -382,6 +382,49 @@ task automatic start_loader;
     end
 endtask
 
+// Exercise the public byte stream with continuous sector data. In particular,
+// accepting 42 must preserve the very first payload byte after the size field.
+task automatic check_data_size;
+    input [31:0] size_bytes;
+    input accepted;
+    integer index;
+    begin
+        @(negedge clk);
+        abort = 1'b1;
+        @(negedge clk);
+        abort = 1'b0;
+        repeat (3) @(posedge clk);
+        while (serving || end_pending || request_complete)
+            @(posedge clk);
+        @(negedge clk);
+        rst = 1'b1;
+        repeat (2) @(negedge clk);
+        rst = 1'b0;
+        clear_disk();
+        clear_observations();
+        make_extensible_pcm_wav();
+        put_file_le32(90, size_bytes);
+        file_size = 32'd94 + size_bytes;
+        for (index = 0; index < 7; index = index + 1) begin
+            put_file_le24(94 + index * 6, 24'h123456 + index * 256);
+            put_file_le24(97 + index * 6, 24'h654321 + index * 256);
+        end
+        $display("TEST 24-bit data chunk size=%0d accepted=%0b", size_bytes, accepted);
+        start_loader();
+        if (accepted) begin
+            while ((frame_count < 8) && !error_seen) @(negedge clk);
+            expect_bit(error_seen, 1'b0, "divisible data size accepted");
+            for (index = 0; index < 7; index = index + 1)
+                expect_frame(index, 16'h1234 + index, 16'h6543 + index,
+                             "all seven frames retain byte alignment");
+            expect_frame(7, 16'h1234, 16'h6543, "42-byte payload loops");
+        end else begin
+            while (!error_seen) @(negedge clk);
+            expect_value(frame_count, 32'd0, "invalid data size emits no frames");
+        end
+    end
+endtask
+
 initial begin
     clear_disk();
     clear_observations();
@@ -486,6 +529,11 @@ initial begin
     #1;
     expect_value(frame_count, 32'd0, "invalid WAV emits no PCM frames");
 
+    check_data_size(32'd40, 1'b0);
+    check_data_size(32'd42, 1'b1);
+    check_data_size(32'd41, 1'b0);
+    check_data_size(32'd0, 1'b0);
+
     $display("PASS tb_fat32_wav_loader");
     $finish;
 end
